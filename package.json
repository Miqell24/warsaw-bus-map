{
  "name": "warsaw-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Warsaw & Grodzisk Mazowiecki public transport (ZTM Warszawa buses/trams/metro/SKM, GPA Grodzisk buses, WKD railway) — GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=6144 pipeline/build.mjs --all --tram all",
    "report": "node pipeline/report-gaps.mjs",
    "serve": "node pipeline/serve.mjs 8155",
    "lines": "node pipeline/lines.mjs",
    "audit": "node --max-old-space-size=6144 pipeline/audit.mjs",
    "schematic": "node --max-old-space-size=4096 pipeline/schematic/build-schematic.mjs"
  }
}
